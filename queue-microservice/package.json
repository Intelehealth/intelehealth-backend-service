{
  "name": "queue-microservice",
  "version": "1.0.0",
  "description": "Intelehealth Queue Management System (QMS) — priority queue, doctor assignment and wait-time estimation. Implements the QMS Low-Level Design and Priority Engine Algorithm Spec on MySQL.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo",
    "seed": "sequelize db:seed:all"
  },
  "dependencies": {
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.2",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}