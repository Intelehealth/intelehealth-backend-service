# =============================================================================
# Intelehealth Queue Management System (QMS)
# Implements the QMS Low-Level Design and the Priority Engine Algorithm Spec.
# Everything below has a working default except the two secrets.
# =============================================================================

# --- Server ---
PORT=3600
NODE_ENV=development
LOG_LEVEL=info

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mindmap_server
DB_USER=root
DB_PASSWORD=
# set to 'true' only in dev to auto-create/update tables from the models
DB_SYNC=false
DB_LOGGING=false

# --- Auth ---
# Existing services (web-rtc, portal) send this as the x-qms-secret header.
QMS_SERVICE_SECRET=change-me-to-a-long-random-string
# Shared RSA public key from OpenMRS/auth-gateway. .pem/ is gitignored — the
# same public_key.pem used by portal and web-rtc must be copied in.
JWT_PUBLIC_KEY_PATH=./.pem/public_key.pem
JWT_ALGORITHMS=RS256
# LLD §13.1 — only these roles may act on another user's behalf.
QMS_ADMIN_ROLES=admin,superadmin

# --- Rate limiting (LLD §13.2) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMIT_PER_MIN=10
RATE_LIMIT_HEARTBEAT_PER_MIN=30
RATE_LIMIT_WINDOW_MS=60000

# --- Queue shape ---
# LLD §13.5 — one shared line per speciality across all facilities
# (SPECIALITY), or one per speciality per facility (SPECIALITY_LOCATION).
# The doc leaves this open; location_uuid is stored either way, so switching
# needs no migration. Decide it with whoever owns the product call.
QUEUE_SCOPE=SPECIALITY
# Priority Engine §05 — critical fast lane. SPECIALITY keeps the lane inside
# the case's own speciality; GLOBAL is LLD §03's literal all-specialities lane.
CRITICAL_LANE_SCOPE=SPECIALITY
# LLD §04 — an SLA-escalated case "sits at the front regardless of score",
# including ahead of the critical lane. Set false for the strict §05.4 reading
# (CRITICAL always first). This is a clinical call — see the README.
ESCALATION_OUTRANKS_CRITICAL=true

# --- Queue tuning ---
# Fallback avg consult time (seconds) for the wait estimate, before a doctor
# has any history.
DEFAULT_CONSULT_SECONDS=480
# No heartbeat for this long flags the entry for review. It is never
# auto-cancelled — a patient may still be waiting even if the app died.
HEARTBEAT_STALE_MINUTES=10
# Assigned but the call never started → back to the queue with a bump.
CONNECTING_TIMEOUT_MINUTES=5
# Connected but nothing reported it finished → swept closed (client crashed).
STALE_AFTER_MINUTES=30
REQUEUE_BONUS=100
DEFAULT_DOCTOR_RATING=4
CONSULT_EMA_ALPHA=0.3
# LLD §06 "no off-day calls" — reuse portal's existing day-off data rather than
# a new calendar table. Off by default: it reads a table owned by portal.
SHIFT_CHECK_ENABLED=false
SHIFT_TABLE=appointment_schedules

# --- Estimated wait time (LLD §07) ---
# A = speciality-pooled, B = doctor-level. Per speciality, because the
# prototype found General Physician needs B while Paediatrics preferred A.
ETA_DEFAULT_MODEL=B
ETA_MODEL_BY_SPECIALITY={"General Physician":"B","Pediatrician":"A"}
# Fixed per-speciality overhead (login delay, case review). ~19-20 min baseline
# from the production calibration; re-tune from /analytics/accuracy.
ETA_DEFAULT_OVERHEAD_MIN=19
ETA_OVERHEAD_BY_SPECIALITY={}

# --- Notifications (LLD §08) ---
# No socket server here: the §08 tiering decides when an outbound push fires
# and what the poll endpoint serves. Point this at portal's notification relay.
NOTIFICATION_ENABLED=true
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_MS=4000
NOTIFICATION_DEBOUNCE_MS=500
NOTIFICATION_DEFERRED_BATCH_MS=10000
NOTIFICATION_PERIODIC_BATCH_MS=75000
NOTIFICATION_EWT_DELTA_MIN=5
NOTIFICATION_EWT_MIN_INTERVAL_MS=30000

# --- Background jobs ---
JOBS_ENABLED=true
# Priority Engine §03 — best-effort cadence; correctness does not depend on it.
AGING_CRON=*/5 * * * *
# Priority Engine §04 — the real anti-starvation guarantee.
SLA_CRON=* * * * *
SWEEP_CRON=*/5 * * * *
ACCURACY_CRON=*/10 * * * *
JOB_BATCH_SIZE=500

# --- ETA accuracy alerting (LLD §13.4) ---
# Ops alerting only, never patient-facing: page whoever is on call when the
# wait estimate drifts, the same way you would for a server outage.
ACCURACY_ALERT_ENABLED=false
ACCURACY_ALERT_WEBHOOK_URL=
ACCURACY_ALERT_MAE_MIN=90
ACCURACY_ALERT_SUSTAINED_MIN=30
ACCURACY_ALERT_LOOKBACK_MIN=60
ACCURACY_ALERT_MIN_SAMPLES=10
