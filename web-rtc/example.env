PORT=3000
SECRET=secret
API_KEY=devkey
SSL=false  # make this true and pass cert and key path below to enable ssl and making site https
SSL_CERT_PATH=/path/to/ssl.cert.pem
SSL_KEY_PATH=/path/to/ssl.key.pem
LIVEHOST=127.0.0.1
TCP=7881
UDP=7882
BRANDNAME=IDA
DOMAIN=dev.intelehealth.org

# Magic link (video call join links)
LIVEKIT_ROOM_HOST=https://dev.intelehealth.org:9090
HW_WEBAPP_URL=http://localhost:3002/

# ---------------------------------------------------------------------------
# Turn (Direct-to-Patient) appointment call links over WhatsApp.
# Everything below is INERT unless IS_TURN_SERVER=true. On a dev/HW deployment
# leave IS_TURN_SERVER unset and none of this code path runs.
# ---------------------------------------------------------------------------
IS_TURN_SERVER=false

# Public base URL of THIS service. The patient's WhatsApp link points here.
PUBLIC_BASE_URL=https://turn.intelehealth.org:3000

# How long before the appointment the WhatsApp link is sent. This is the
# "~15 minutes" knob -- change it here and restart, nothing else.
TURN_CALL_LINK_LEAD_MINUTES=15

# Also send to appointments that started up to this many minutes ago (so a
# restart or a missed tick still delivers the link).
TURN_CALL_LINK_GRACE_MINUTES=10

# MASTER SWITCH for the T-15 auto-send cron. Off by default: the turn.io journey
# already sends the link that bookAppointment returns, so enabling this too would
# send the patient TWO links. Only turn this on if the journey does NOT send one.
TURN_CALL_LINK_ENABLED=false

# Cron expression for the dispatch job.
TURN_CALL_LINK_CRON=*/1 * * * *

# Dispatch is claimed in the turn_call_links table (UNIQUE per appointment), so a
# restart or a second replica cannot re-send. A claim left "sending" for longer
# than this (crash mid-send) is reclaimed. Total sends per appointment are capped
# by MAX_ATTEMPTS.
TURN_CALL_LINK_STALE_MINUTES=5
TURN_CALL_LINK_MAX_ATTEMPTS=3

# Window in which the short link actually opens the call, relative to slot time.
TURN_CALL_LINK_OPEN_BEFORE_MINUTES=30
TURN_CALL_LINK_OPEN_AFTER_MINUTES=120

# TTL of the LiveKit magic token minted when the patient taps the link.
TURN_CALL_LINK_TTL_MINUTES=120

# turn.io WhatsApp API (app.turn.io -> Settings -> API)
TURN_API_TOKEN=
TURN_API_URL=https://whatsapp.turn.io/v1/messages

# Log the outbound WhatsApp payload and send nothing. Use for the first deploy.
TURN_DRY_RUN=true

# A T-15 message falls OUTSIDE WhatsApp's 24h session window, so a free-form
# text will not deliver. Set an approved template name to send an HSM instead.
# Template body must take 3 params: {{1}} patient name, {{2}} time, {{3}} link.
TURN_APPOINTMENT_TEMPLATE_NAME=
TURN_APPOINTMENT_TEMPLATE_NAMESPACE=
TURN_APPOINTMENT_TEMPLATE_LANG=en

# OpenMRS REST, used to resolve the patient's WhatsApp number.
OPENMRS_REST_URL=https://dev.intelehealth.org/openmrs/ws/rest/v1
OPENMRS_USERNAME=
OPENMRS_PASSWORD=
OPENMRS_PHONE_ATTRIBUTE=Telephone Number

# --- QMS (Queue Management System) integration — feature-flagged ---
# When QMS_ENABLED=true, call start/end also update the queue-microservice.
# Default off: absent or any value other than 'true' disables it entirely
# (existing behaviour unchanged). Calls are fire-and-forget — a QMS outage
# never affects the WebRTC call flow.
QMS_ENABLED=false
QMS_BASE_URL=http://queue-microservice:3600
QMS_SERVICE_SECRET=
